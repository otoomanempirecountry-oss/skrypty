-- [[ ELITE PANEL V73 | ULTIMATE INTERACT REACH ]]
-- FIX: JEŚLI STANDARDOWE METODY NIE DZIAŁAJĄ
-- OPTIMIZED FOR DELTA MOBILE | 100% UNC & SYNC

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "ELITE V73 | GOD REACH",
   LoadingTitle = "Ładowanie Systemu Przymusu...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local lp = game.Players.LocalPlayer
local rs = game:GetService("RunService")

-- Zmienne
local reachRange = 100
local autoInteract = false

-- [[ TAB: REACH ]]
local ReachTab = Window:CreateTab("God Reach", 4483362458)

ReachTab:CreateSlider({
   Name = "Zasięg Reach",
   Range = {10, 1000},
   Increment = 10,
   CurrentValue = 100,
   Callback = function(v)
      reachRange = v
   end,
})

ReachTab:CreateToggle({
   Name = "Włącz ULTIMATE REACH",
   CurrentValue = false,
   Callback = function(v)
      autoInteract = v
      if v then
         task.spawn(function()
            while autoInteract do
               task.wait(0.1)
               local char = lp.Character
               local root = char and char:FindFirstChild("HumanoidRootPart")
               
               if root then
                  for _, obj in pairs(workspace:GetDescendants()) do
                     if not autoInteract then break end
                     
                     -- Szukamy interakcji
                     if obj:IsA("ProximityPrompt") then
                        local target = obj.Parent
                        if target and target:IsA("BasePart") then
                           local dist = (root.Position - target.Position).Magnitude
                           
                           if dist <= reachRange then
                              -- METODA 1: Wymuszenie zasięgu w kółku
                              obj.MaxActivationDistance = reachRange
                              
                              -- METODA 2: Próba UNC Fire (najszybsza)
                              fireproximityprompt(obj)
                              
                              -- METODA 3: FireTouch (jeśli przycisk wymaga dotknięcia pola)
                              firetouchinterest(root, target, 0)
                              firetouchinterest(root, target, 1)
                           end
                        end
                     end
                  end
               end
            end
         end)
      end
   end,
})

ReachTab:CreateSection("Dodatki")

ReachTab:CreateButton({
   Name = "Instant Hold (Usuń czekanie)",
   Callback = function()
      for _, v in pairs(workspace:GetDescendants()) do
         if v:IsA("ProximityPrompt") then
            v.HoldDuration = 0
         end
      end
      Rayfield:Notify({Title = "Reach", Content = "Usunięto czas trzymania E!", Duration = 2})
   end,
})

-- [[ TAB: MOVEMENT ]]
local MoveTab = Window:CreateTab("Movement", 4483362458)

MoveTab:CreateToggle({
   Name = "Auto-Jump",
   CurrentValue = false,
   Callback = function(v)
      _G.AJ = v
      task.spawn(function()
         while _G.AJ do
            task.wait(0.05)
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
               if lp.Character.Humanoid.FloorMaterial ~= Enum.Material.Air then
                  lp.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
               end
            end
         end
      end)
   end,
})

MoveTab:CreateSlider({
   Name = "WalkSpeed",
   Range = {16, 300},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(v)
      if lp.Character and lp.Character:FindFirstChild("Humanoid") then
         lp.Character.Humanoid.WalkSpeed = v
      end
   end,
})

-- [[ TAB: UTILITY ]]
local UtilTab = Window:CreateTab("Utility", 4483362458)

UtilTab:CreateButton({
   Name = "Anti-AFK",
   Callback = function()
      lp.Idled:Connect(function()
         game:GetService("VirtualUser"):CaptureController()
         game:GetService("VirtualUser"):ClickButton2(Vector2.new())
      end)
   end,
})
