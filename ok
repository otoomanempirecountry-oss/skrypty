-- [[ ELITE PANEL V74 | SEPARATED REACH & AUTO ]]
-- OPTIMIZED FOR DELTA MOBILE | 100% UNC & SYNC
-- ROZDZIELONE FUNKCJE INTERAKCJI

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "ELITE V74 | STABLE INTERACT",
   LoadingTitle = "Ładowanie Systemów...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local lp = game.Players.LocalPlayer
local rs = game:GetService("RunService")

-- Zmienne
local reachRange = 100
local autoInteractEnabled = false
local passiveReachEnabled = false

-- [[ TAB: REACH CONTROL ]]
local ReachTab = Window:CreateTab("Interact Control", 4483362458)

ReachTab:CreateSlider({
   Name = "Ustaw Zasięg (Reach)",
   Range = {10, 1000},
   Increment = 10,
   CurrentValue = 100,
   Callback = function(v)
      reachRange = v
   end,
})

ReachTab:CreateToggle({
   Name = "Passive Reach (Zasięg kółka E)",
   CurrentValue = false,
   Info = "Zwiększa dystans, z którego widzisz i możesz kliknąć 'E'",
   Callback = function(v)
      passiveReachEnabled = v
      task.spawn(function()
         while passiveReachEnabled do
            task.wait(0.5)
            for _, obj in pairs(workspace:GetDescendants()) do
               if not passiveReachEnabled then break end
               if obj:IsA("ProximityPrompt") then
                  obj.MaxActivationDistance = reachRange
               end
            end
         end
      end)
   end,
})

ReachTab:CreateToggle({
   Name = "AUTO-INTERACT (Samo klika)",
   CurrentValue = false,
   Info = "Skrypt sam będzie wciskać 'E' za Ciebie w zasięgu Reach",
   Callback = function(v)
      autoInteractEnabled = v
      if v then
         task.spawn(function()
            while autoInteractEnabled do
               task.wait(0.1)
               local char = lp.Character
               local root = char and char:FindFirstChild("HumanoidRootPart")
               
               if root then
                  for _, obj in pairs(workspace:GetDescendants()) do
                     if not autoInteractEnabled then break end
                     
                     if obj:IsA("ProximityPrompt") then
                        local parent = obj.Parent
                        if parent and parent:IsA("BasePart") then
                           local dist = (root.Position - parent.Position).Magnitude
                           
                           if dist <= reachRange then
                              -- Wykonujemy interakcję (Hybryda UNC)
                              fireproximityprompt(obj)
                              firetouchinterest(root, parent, 0)
                              firetouchinterest(root, parent, 1)
                           end
                        end
                     end
                  end
               end
            end
         end)
      end
   end,
})

-- [[ TAB: MOVEMENT ]]
local MoveTab = Window:CreateTab("Movement", 4483362458)

MoveTab:CreateToggle({
   Name = "Auto-Jump",
   CurrentValue = false,
   Callback = function(v)
      _G.AJ = v
      task.spawn(function()
         while _G.AJ do
            task.wait(0.05)
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
               if lp.Character.Humanoid.FloorMaterial ~= Enum.Material.Air then
                  lp.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
               end
            end
         end
      end)
   end,
})

MoveTab:CreateSlider({
   Name = "WalkSpeed",
   Range = {16, 350},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(v)
      if lp.Character and lp.Character:FindFirstChild("Humanoid") then
         lp.Character.Humanoid.WalkSpeed = v
      end
   end,
})

-- [[ TAB: UTILITY ]]
local UtilTab = Window:CreateTab("Utility", 4483362458)

UtilTab:CreateButton({
   Name = "Instant Hold (No Wait)",
   Callback = function()
      for _, v in pairs(workspace:GetDescendants()) do
         if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end
      end
      Rayfield:Notify({Title = "Reach", Content = "Zredukowano czas trzymania E do 0!", Duration = 2})
   end,
})

UtilTab:CreateButton({
   Name = "Anti-AFK",
   Callback = function()
      lp.Idled:Connect(function()
         game:GetService("VirtualUser"):CaptureController()
         game:GetService("VirtualUser"):ClickButton2(Vector2.new())
      end)
   end,
})
