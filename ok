-- [[ ELITE PANEL V72 | PROXIMITY REACH MASTER ]]
-- CEL: Zwiększenie zasięgu interakcji (Kółka E) i Auto-Interact
-- OPTIMIZED FOR DELTA MOBILE

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "ELITE V72 | INTERACT REACH",
   LoadingTitle = "Inicjacja Systemu E...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local lp = game.Players.LocalPlayer
local rs = game:GetService("RunService")

-- Zmienne
local proximityReach = 100
local autoInteract = false
local instantInteract = false

-- [[ TAB: REACH E ]]
local ReachTab = Window:CreateTab("Interact Reach", 4483362458)

ReachTab:CreateSlider({
   Name = "Zasięg Interakcji (Reach)",
   Range = {10, 1000},
   Increment = 10,
   CurrentValue = 100,
   Callback = function(v)
      proximityReach = v
   end,
})

ReachTab:CreateToggle({
   Name = "Włącz Proximity Reach",
   CurrentValue = false,
   Callback = function(v)
      _G.ProxReach = v
      task.spawn(function()
         while _G.ProxReach do
            task.wait(0.2)
            for _, obj in pairs(workspace:GetDescendants()) do
               if obj:IsA("ProximityPrompt") then
                  -- Zwiększamy zasięg kółka E
                  obj.MaxActivationDistance = proximityReach
                  
                  -- Jeśli Instant Interact jest włączone
                  if instantInteract then
                     obj.HoldDuration = 0
                  end
               end
            end
         end
      end)
   end,
})

ReachTab:CreateToggle({
   Name = "Instant Interact (Bez czekania)",
   CurrentValue = false,
   Callback = function(v)
      instantInteract = v
   end,
})

ReachTab:CreateToggle({
   Name = "AUTO-INTERACT (Samo klika E)",
   CurrentValue = false,
   Callback = function(v)
      autoInteract = v
      task.spawn(function()
         while autoInteract do
            task.wait(0.1)
            for _, obj in pairs(workspace:GetDescendants()) do
               if obj:IsA("ProximityPrompt") then
                  local parent = obj.Parent
                  if parent and parent:IsA("BasePart") then
                     local dist = (lp.Character.HumanoidRootPart.Position - parent.Position).Magnitude
                     if dist <= proximityReach then
                        -- Wywołuje interakcję bez klikania
                        fireproximityprompt(obj)
                     end
                  end
               end
            end
         end
      end)
   end,
})

-- [[ TAB: MOVEMENT ]]
local MoveTab = Window:CreateTab("Movement", 4483362458)

MoveTab:CreateToggle({
   Name = "Auto-Jump",
   CurrentValue = false,
   Callback = function(v)
      _G.AJ = v
      task.spawn(function()
         while _G.AJ do
            task.wait(0.05)
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
               if lp.Character.Humanoid.FloorMaterial ~= Enum.Material.Air then
                  lp.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
               end
            end
         end
      end)
   end,
})

MoveTab:CreateSlider({
   Name = "Speed",
   Range = {16, 300},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(v)
      if lp.Character and lp.Character:FindFirstChild("Humanoid") then
         lp.Character.Humanoid.WalkSpeed = v
      end
   end,
})

-- [[ TAB: UTILITY ]]
local UtilTab = Window:CreateTab("Utility", 4483362458)

UtilTab:CreateButton({
   Name = "Anti-AFK",
   Callback = function()
      lp.Idled:Connect(function()
         game:GetService("VirtualUser"):CaptureController()
         game:GetService("VirtualUser"):ClickButton2(Vector2.new())
      end)
   end,
})

UtilTab:CreateButton({
   Name = "Powiększ Hitboxy Graczy",
   Callback = function()
      for _, p in pairs(game.Players:GetPlayers()) do
         if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            p.Character.HumanoidRootPart.Size = Vector3.new(15, 15, 15)
            p.Character.HumanoidRootPart.Transparency = 0.7
         end
      end
   end,
})
